BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

NEXT_PUBLIC_COCKPIT_URL=http://localhost:3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/start_cockpit"

# Google OAuth login. Required unless ENABLE_DEV_LOGIN=true (see below).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development toggles. Both default to off — enable them ONLY in your
# local .env, never in a deployed environment.
# ENABLE_DEV_LOGIN: adds a passwordless "sign in by email" form at /auth that
# logs in any existing user with no verification. It only works on localhost and
# is hard-blocked when NODE_ENV=production. When set, GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET become optional and Google OAuth can be omitted.
# DISABLE_GOOGLE_WORKSPACE: turns all Admin SDK / Directory / Drive writes into
# no-ops and makes GOOGLE_APPLICATION_CREDENTIALS_BASE64 +
# GOOGLE_DRIVE_LEGAL_DOCUMENTS_FOLDER_ID optional.
ENABLE_DEV_LOGIN=false
DISABLE_GOOGLE_WORKSPACE=false

# Transactional email (AWS SES v2). All four are required by src/env.ts.
# Locally you can use placeholders together with DISABLE_EMAIL=true.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_SNS_TOPIC_ARN=
DISABLE_EMAIL=false

# --- Newsletter app (src/internal-apps/newsletter) --------------------------
# Marketing email goes through Resend on its own sending domain, kept separate
# from SES so newsletter complaints cannot damage transactional deliverability.
#
# NEWSLETTER_SEND_MODE=sandbox intercepts and logs every send instead of
# dispatching it. It is the default on purpose; switching to "live" should be a
# deliberate act.
NEWSLETTER_SEND_MODE=sandbox
RESEND_API_KEY=
RESEND_NEWSLETTER_SEGMENT_ID=
RESEND_NEWSLETTER_TOPIC_ID=

# Image storage: "local" writes to .uploads/, "blob" uses Vercel Blob.
NEWSLETTER_STORAGE=local
BLOB_READ_WRITE_TOKEN=

# Optional writing help. Without a key the feature is cleanly disabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

GOOGLE_APPLICATION_CREDENTIALS_BASE64=

SLACK_BOT_TOKEN=
NGROK_AUTH_TOKEN=

GOCARDLESS_API_KEY=
GOCARDLESS_BASE_URL=https://api-sandbox.gocardless.com
GOCARDLESS_WEBHOOK_SECRET=

# Recruiting referrals. Configure the campaign with npm run referrals:setup.
# TALLY_API_KEY=
# TALLY_ORGANIZATION_ID=
# Optional override. Otherwise derived securely from TALLY_API_KEY.
# TALLY_REFERRALS_WEBHOOK_SECRET=
